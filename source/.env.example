# marianos-azure-headless: environment for a local run (copy to .env, never commit .env).
# In Azure these are set on the job; the secrets are Key Vault references (see docs/AZURE.md).

# PostgreSQL (psycopg). A password may be in the URL or in PGPASSWORD.
MARIANOS_COLLECTOR_DATABASE_URL=postgresql://marianos_collector@localhost:5432/marianos_collector
# PGPASSWORD=
# entra = Azure Database for PostgreSQL with the job's managed identity (no password)
# MARIANOS_COLLECTOR_DATABASE_AUTH=entra

# The key of the provider named in config/settings.yaml (acquisition.browser_provider); the other is unused.
# Oxylabs Web API (the shipped default): a protected file holding the Bearer key (NAME=value, NAME: value
# or the bare key), or the key itself
OXYLABS_WEB_API_KEY_FILE=/etc/marianos-collector/oxylabs.env
# OXYLABS_WEB_API_KEY=
# Scrapfly: the key itself, or a file holding it (an Azure secret volume)
# SCRAPFLY_API_KEY=
# SCRAPFLY_API_KEY_FILE=/mnt/secrets/scrapfly-api-key

# Configuration and storage
MARIANOS_COLLECTOR_CONFIG=config/collector.yaml
# MARIANOS_COLLECTOR_STORAGE=azure_blob
# MARIANOS_COLLECTOR_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
# MARIANOS_COLLECTOR_BLOB_CONTAINER=marianos-collector
# MARIANOS_COLLECTOR_DATA_DIR=./data
# MARIANOS_COLLECTOR_LOG_LEVEL=INFO
