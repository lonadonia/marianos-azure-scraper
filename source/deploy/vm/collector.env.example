# /etc/marianos-collector/collector.env (root:marianos, mode 640), read by systemd as data (deploy/vm/marianos).
# No secret here: the provider key is in its own file, readable only by the service user (mode 600).
# Local PostgreSQL through its socket, peer authentication (the service user's own role): no password.
MARIANOS_COLLECTOR_DATABASE_URL=postgresql://marianos@/marianos_collector?host=/var/run/postgresql
MARIANOS_COLLECTOR_CONFIG=/etc/marianos-collector/config/collector.yaml
MARIANOS_COLLECTOR_CONFIG_DIR=/etc/marianos-collector/config
MARIANOS_COLLECTOR_DATA_DIR=/var/lib/marianos-collector/data
OXYLABS_WEB_API_KEY_FILE=/etc/marianos-collector/oxylabs.env
MARIANOS_COLLECTOR_LOG_LEVEL=INFO
