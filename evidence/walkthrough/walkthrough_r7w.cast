[4.489, "o", "[exit 0]\r\n"]
[4.489, "o", "\r\n"]
[4.489, "o", "# Resume the run as a service (it survives a lost SSH session), two lanes, and follow its log. After 12 pages\r\n"]
[4.839, "o", "# it is stopped with SIGTERM (systemctl stop): the collector records a resumable stop (exit 75).\r\n"]
[5.19, "o", "\r\n"]
