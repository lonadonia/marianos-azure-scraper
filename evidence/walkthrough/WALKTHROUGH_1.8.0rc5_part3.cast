[8.188, "o", "\r\n"]
[8.188, "o", "# The rule now: every page the run stored must still match its recorded SHA-256, as before. A fetch that brought\r\n"]
[8.547, "o", "# no page fails G13 only if a product, offer, placement or listing-page row of the run, or a record's provenance,\r\n"]
[8.906, "o", "# names it as a source. The two regressions below run on 1.8.0rc5 from the clean extraction of its archive, on\r\n"]
[9.25, "o", "# a disposable test database.\r\n"]
[9.594, "o", "\r\n"]
[9.594, "o", "$ pytest tests/integration/test_listing_pages.py -k \"never_brought or depends_on\" (1.8.0rc5, clean extraction)\r\n"]
[52.266, "o", "====================== 2 passed, 25 deselected in 37.86s ======================\r\n"]
[52.281, "o", "[exit 0]\r\n"]
[52.281, "o", "\r\n"]
[52.281, "o", "$ the same two tests on 1.8.0rc4 (saved before the commit, 14:19Z)\r\n"]
