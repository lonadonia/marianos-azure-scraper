#!/bin/bash
# PRIVATE OPS on the owner VM (installed as /usr/local/sbin/mstage6; release 1.10.0rc6, campaign from ops.env): the gated-stage harness (live_rc6_run.py) run as
# the service user with the target's env file, the current release's release.env and the ops env (none holds a
# secret; the key stays in its own 0600 file). Run as root.
#
#   mstage ARGS...               one harness command; waits, output on this terminal, exit code kept
#   mstage --unit NAME ARGS...   a long command as the transient unit NAME (marianos-stage-*): it survives a lost SSH
#                                session; output in the journal; `systemctl stop NAME` sends SIGTERM (a resumable stop)
set -euo pipefail
CURRENT=/opt/marianos-collector/current
OPS=/var/lib/marianos-collector/ops-rc6
common=(--uid=marianos --gid=marianos
  -p EnvironmentFile=/etc/marianos-collector/collector.env -p EnvironmentFile="$CURRENT/release.env"
  -p EnvironmentFile="$OPS/ops.env"
  -p WorkingDirectory=/var/lib/marianos-collector -p NoNewPrivileges=yes -p PrivateTmp=yes)
service=(-p KillSignal=SIGTERM -p TimeoutStopSec=120)
[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 2; }
case "${1:-}" in
  --unit)
    unit="${2:?NAME}"; [[ "$unit" =~ ^marianos-stage-[a-z0-9-]+$ ]] || { echo "unit names are marianos-stage-<a-z0-9->" >&2; exit 2; }
    shift 2
    exec systemd-run --quiet --unit="$unit" "${service[@]}" "${common[@]}" "$CURRENT/venv/bin/python" -I "$OPS/live_rc6_run.py" "$@" ;;
esac
exec systemd-run --quiet --wait --pipe --collect "${common[@]}" "$CURRENT/venv/bin/python" -I "$OPS/live_rc6_run.py" "$@"
