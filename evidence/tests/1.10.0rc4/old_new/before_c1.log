            upcs = set(s.scalars(select(RecordRow.upc).where(RecordRow.run_id == run_id)))
        lines = {x["listing_id"]: x for x in report["listings"]}
        c1.evidence(f"case3 c1 brand reading {what}", SYNTHETIC, {"asked": site.asked, "observed": obs,
