index 0000000..5940a17
--- /dev/null
+++ b/headless/marianos-azure-headless/tests/integration/test_run_order_rc6.py
@@ -0,0 +1,203 @@
+"""Release 1.10.0rc6: the order a run reads its listings in, and the product pages it reads (the estimate made
+from run F2's traces before the next paid run).
+
+- Depth first: run F2 (1.10.0rc5) planned the subdivisions of 25 listings above the site's 250-result window
+  and read none of them before it stopped, because a subdivision was leased after every listing of the plan
+  (by creation). A listing's subdivisions are now leased before the plan's next listing.
+- ``rows_first``: CSV rows read first, in a chosen order; the plan is the same.
+- ``product_term_upcs``: only the named products' own pages are read (with ``coverage.read_product_terms``
+  on, every tile's page would be one more request: about as many requests as products).
+
+Tests named ``test_rc6_...`` fail on 1.10.0rc5."""
+
+from __future__ import annotations
+
+from datetime import timedelta
+from typing import Any
+
+import pytest
+from sqlalchemy import Engine, select
+
+from marianos_headless.collection import control
+from marianos_headless.collection.config import CollectionConfig, Limits
+from marianos_headless.core.settings import Settings
+from marianos_headless.core.timeutil import utcnow
+from marianos_headless.db import queue
+from marianos_headless.db.models import ProductObservation
+from tests.integration import test_product_terms_collector as terms
+from tests.integration.helpers import new_run, seed
+
+pytestmark = pytest.mark.postgres
+
+vh_env = terms.vh_env
+
+
+def _drain(s: Any, run_id: str) -> list[str]:
+    order: list[str] = []
+    while (lease := queue.lease_next(s, run_id, "w1")) is not None:
+        order.append(str(lease.taxonomy_id))
+        queue.succeed(s, lease)
+        s.commit()
+    return order
+
+
+def test_rc6_a_listings_subdivisions_are_read_before_the_plans_next_listing(migrated_engine: Engine) -> None:
+    factory, store = seed(migrated_engine)
+    run = new_run(factory, store)
+    with factory() as s:
+        for i, tax in enumerate(("06111", "06112", "06113", "06114")):
+            queue.enqueue(
+                s, run.id, "listing_node", f"{run.id}/node/{i:04d}-{tax}", priority=50, taxonomy_id=tax
+            )
+        s.commit()
+        first = queue.lease_next(s, run.id, "w1")
+        second = queue.lease_next(s, run.id, "w2")
+        assert first is not None and second is not None
+        assert (first.taxonomy_id, second.taxonomy_id) == ("06111", "06112")
+        s.commit()
+        # 06112 is above the window: its page 1 names its subdivisions, planned now (after the whole plan).
+        for child in ("0611200694", "0611200691"):
+            queue.enqueue(
+                s, run.id, "listing_node", f"{second.idem_key}/{child}", priority=50, taxonomy_id=child
+            )
+        s.commit()
+        queue.succeed(s, first)
+        queue.succeed(s, second)
+        s.commit()
+        order = _drain(s, run.id)
+        # Both subdivisions (in the order they were planned) before the plan's next listing.
+        assert set(order[:2]) == {"0611200691", "0611200694"} and order[2:] == ["06113", "06114"]
+
+
+def test_rc6_subdivisions_keep_the_order_they_were_planned_in(migrated_engine: Engine) -> None:
+    factory, store = seed(migrated_engine)
+    run = new_run(factory, store)
+    with factory() as s:
+        queue.enqueue(
+            s, run.id, "listing_node", f"{run.id}/node/0000-03001", priority=50, taxonomy_id="03001"
+        )
+        queue.enqueue(
+            s, run.id, "listing_node", f"{run.id}/node/0001-03002", priority=50, taxonomy_id="03002"
+        )
+        s.commit()
+        parent = queue.lease_next(s, run.id, "w1")
+        assert parent is not None and parent.taxonomy_id == "03001"
+        # Brand readings: their IDs are digests, so key order is not the facet's order; one per transaction
+        # here so that each has its own creation time (planned in the facet's order: zeta, then alpha).
+        for pid in ("ffff000001", "0000000002"):
+            queue.enqueue(s, run.id, "listing_node", f"{parent.idem_key}/{pid}", priority=50, taxonomy_id=pid)
+            s.commit()
+        queue.succeed(s, parent)
+        s.commit()
+        assert _drain(s, run.id) == ["ffff000001", "0000000002", "03002"]
+
+
+def test_keys_without_a_place_in_the_plan_keep_their_creation_order(migrated_engine: Engine) -> None:
+    factory, store = seed(migrated_engine)
+    run = new_run(factory, store)
+    with factory() as s:
+        for tax in ("26003", "26002"):
+            queue.enqueue(s, run.id, "listing_node", f"{run.id}/listing/{tax}", priority=50, taxonomy_id=tax)
+            s.commit()
+        assert _drain(s, run.id) == ["26003", "26002"]
+
+
+def test_rc6_a_subdivision_waiting_for_its_re_ask_holds_no_lane(migrated_engine: Engine) -> None:
+    factory, store = seed(migrated_engine)
+    run = new_run(factory, store)
+    t0 = utcnow()
+    with factory() as s:
+        queue.enqueue(
+            s, run.id, "listing_node", f"{run.id}/node/0000-06112", priority=50, taxonomy_id="06112"
+        )
+        queue.enqueue(
+            s, run.id, "listing_node", f"{run.id}/node/0001-06113", priority=50, taxonomy_id="06113"
+        )
+        s.commit()
+        # The subdivision is planned after its listing (as when the listing's page 1 names it).
+        queue.enqueue(
+            s,
+            run.id,
+            "listing_node",
+            f"{run.id}/node/0000-06112/0611200694",
+            priority=50,
+            taxonomy_id="0611200694",
+        )
+        s.commit()
+        parent = queue.lease_next(s, run.id, "w1", now=t0)
+        assert parent is not None and parent.taxonomy_id == "06112"
+        queue.succeed(s, parent)
+        s.commit()
+        child = queue.lease_next(s, run.id, "w1", now=t0)
+        assert child is not None and child.taxonomy_id == "0611200694"
+        # Its page 2 repeated page 1: the request is set aside for 300 s (C1).
+        queue.defer(s, child, not_before=t0 + timedelta(seconds=300))
+        s.commit()
+        nxt = queue.lease_next(s, run.id, "w1", now=t0 + timedelta(seconds=1))
+        assert nxt is not None and nxt.taxonomy_id == "06113"
+        queue.succeed(s, nxt)
+        s.commit()
+        assert queue.lease_next(s, run.id, "w1", now=t0 + timedelta(seconds=2)) is None
+        again = queue.lease_next(s, run.id, "w1", now=t0 + timedelta(seconds=301))
+        assert again is not None and again.taxonomy_id == "0611200694"
+
+
+def test_rc6_rows_first_reads_the_named_rows_first_and_keeps_the_plan() -> None:
+    cfg = CollectionConfig(rows_first=[22, 27, 22, 15])
+    assert cfg.rows_first == [22, 27, 15]
+    seed_rows = control.load_seed()
+    sources = {
+        int(r["row_index"]): (r["category"], f"id{r['row_index']}", str(r.get("url") or ""))
+        for r in seed_rows["rows"]
+    }
+    nodes, _ = control.plan_nodes(seed_rows, sources, [], {})
+    ordered = control.rows_first(nodes, cfg.rows_first)
+    assert sorted(n.taxonomy_id for n in ordered) == sorted(n.taxonomy_id for n in nodes)
+    rows = [n.row_index for n in ordered]
+    first = [r for r in rows if r in (22, 27, 15)]
+    assert rows[: len(first)] == first and first == sorted(first, key=[22, 27, 15].index)
+    rest = [n for n in ordered if n.row_index not in (22, 27, 15)]
+    assert rest == [n for n in nodes if n.row_index not in (22, 27, 15)]
+
+
+def test_rc6_a_product_is_named_by_its_upc() -> None:
+    assert Limits(product_term_upcs=["0001780014939", " 0001780014939 "]).product_term_upcs == [
+        "0001780014939"
+    ]
+    with pytest.raises(ValueError, match="13-digit UPC"):
+        Limits(product_term_upcs=["1780014939"])
+    assert not Limits(product_term_upcs=["0001780014939"]).bounded()  # not a scope limit
+
+
+def _terms_of(env: dict[str, Any], run_id: str) -> dict[str, Any]:
+    with env["factory"]() as s:
+        return {
+            o.upc: (o.provenance or {}).get("coupon_terms", {}).get("status")
+            for o in s.scalars(select(ProductObservation).where(ProductObservation.run_id == run_id))
+        }
+
+
+def test_rc6_only_the_named_products_pages_are_read(vh_env: dict[str, Any], settings: Settings) -> None:
+    terms._ceiling(vh_env["factory"], 20)
+    fake = terms.FakeTermsApi()
+    named = [terms.TEMPTATIONS.upc, terms.PURINA.upc, terms.PLAIN.upc]
+    run_id = terms._run(vh_env, settings, fake, read=False, limits=Limits(product_term_upcs=named))
+    # In page order, once each, whatever the card shows (PLAIN's card shows no coupon).
+    assert terms._product_pages(fake) == [terms.PURINA.upc, terms.TEMPTATIONS.upc, terms.PLAIN.upc]
+    status = _terms_of(vh_env, run_id)
+    assert status[terms.PURINA.upc] == "read"
+    assert status[terms.TEMPTATIONS.upc] == "request_failed" and status[terms.PLAIN.upc] == "request_failed"
+    assert status[terms.LAMB.upc] is None and status[terms.ENERGIZER.upc] is None
+
+
+def test_rc6_named_products_narrow_the_setting_that_reads_every_coupon_card(
+    vh_env: dict[str, Any], settings: Settings
+) -> None:
+    terms._ceiling(vh_env["factory"], 20)
+    fake = terms.FakeTermsApi()
+    run_id = terms._run(
+        vh_env, settings, fake, read=True, limits=Limits(product_term_upcs=[terms.ENERGIZER.upc])
+    )
+    assert terms._product_pages(fake) == [terms.ENERGIZER.upc]
+    status = _terms_of(vh_env, run_id)
+    assert status[terms.ENERGIZER.upc] == "request_failed" and status[terms.PURINA.upc] is None
diff --git a/headless/marianos-azure-headless/tests/integration/test_validate_export_or20.py b/headless/marianos-azure-headless/tests/integration/test_validate_export_or20.py
new file mode 100644
index 0000000..57c92a0
--- /dev/null
+++ b/headless/marianos-azure-headless/tests/integration/test_validate_export_or20.py
@@ -0,0 +1,205 @@
+"""OR-20 (release 1.10.0rc6): ``validate-export --run`` reads a run's stored sources one at a time, with
+bounded memory, and checks every exported record's capture and source values.
+
+Run F2 (1.10.0rc5, 2026-11-16) was validated on the operator's VM after its stop: the command read all 575
+stored listing pages into memory before indexing any of them and was killed for lack of memory (about 3.3 GiB
+of a 3.8 GiB VM without swap). These tests drive the command over a synthetic run (``tests/c1_site.py``: pages
+behind a local mock transport, nothing reaches a provider) on a throwaway PostgreSQL.
+
+Tests named ``test_or20_...`` state what 1.10.0rc6 adds and fail on 1.10.0rc5; ``test_control_...`` state
+what must hold before and after."""
+
+from __future__ import annotations
+
+import gzip
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+from sqlalchemy import Engine, select, update
+
+from marianos_headless import operations
+from marianos_headless.checks import source_check
+from marianos_headless.core.settings import PrivateLabelConfig, Settings
+from marianos_headless.db.models import Artifact, ExportRow, PageFetch
+from tests import c1_site as c1
+from tests.c1_site import C1Site, Clock
+from tests.listing_site import products
+
+pytestmark = [pytest.mark.postgres]
+
+
+@pytest.fixture
+def env(migrated_engine: Engine, tmp_path: Path, private_label: PrivateLabelConfig) -> dict[str, Any]:
+    return c1.make_env(migrated_engine, tmp_path, private_label)
+
+
+def _validated_run(env: dict[str, Any], settings: Settings) -> str:
+    clock = Clock()
+    site = C1Site({"03001": products(60)}, clock)
+    run_id, status = c1.run(env, settings, site, clock)
+    assert status == "validated", status
+    return run_id
+
+
+def _validate(env: dict[str, Any], run_id: str, storage: Any = None) -> tuple[int, dict[str, Any]]:
+    ctx = SimpleNamespace(factory=env["factory"], storage=storage or env["storage"])
+    code, report = operations.validate_export(ctx, None, run_id)  # type: ignore[arg-type]
+    return int(code), report
+
+
+def _page_keys(env: dict[str, Any], run_id: str) -> dict[str, str]:
+    """The run's stored listing pages: page address -> storage key."""
+    with env["factory"]() as s:
+        return {
+            url: key
+            for url, key in s.execute(
+                select(PageFetch.url, Artifact.key)
+                .join(Artifact, PageFetch.dom_artifact_id == Artifact.id)
+                .where(PageFetch.run_id == run_id, PageFetch.purpose == "listing")
+            )
+        }
+
+
+def _rewrite_export(env: dict[str, Any], run_id: str, name: str, data: bytes) -> None:
+    """Replace one exported file and re-seal it: the manifest states the new file's hash and size, and the
+    run's record of the manifest the manifest's new hash. Only the file's content then differs."""
+    root = env["tmp"] / "data"
+    with env["factory"]() as s:
+        manifest = s.scalar(
+            select(Artifact)
+            .join(ExportRow, ExportRow.artifact_id == Artifact.id)
+            .where(ExportRow.run_id == run_id, ExportRow.kind == "manifest")
+        )
+        assert manifest is not None
+        body = json.loads((root / manifest.key).read_bytes())
+        entry = body["files"][name]
+        (root / entry["key"]).write_bytes(data)
+        entry.update(sha256=hashlib.sha256(data).hexdigest(), size=len(data))
+        sealed = json.dumps(body, indent=2).encode("utf-8")
+        (root / manifest.key).write_bytes(sealed)
+        s.execute(
+            update(Artifact)
+            .where(Artifact.id == manifest.id)
+            .values(sha256=hashlib.sha256(sealed).hexdigest())
+        )
+        s.commit()
+
+
+class _Recorder:
+    """The run's storage, noting each read of a stored listing page."""
+
+    def __init__(self, inner: Any, pages: set[str], log: list[tuple[str, str]]) -> None:
+        self.inner, self.pages, self.log = inner, pages, log
+
+    def get_bytes(self, key: str) -> bytes:
+        if key in self.pages:
+            self.log.append(("read", key))
+        return bytes(self.inner.get_bytes(key))
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self.inner, name)
+
+
+def test_or20_validate_export_reads_each_stored_page_before_the_next_and_checks_every_records_capture(
+    env: dict[str, Any], settings: Settings, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Expected to FAIL on 1.10.0rc5 (it reads every page before reading the product data of any, and has
+    no capture check). Each stored page is read, and its product data taken, before the next page is read;
+    every exported record's capture, as the published supporting log names it, is a stored page with that
+    SHA-256."""
+    run_id = _validated_run(env, settings)
+    keys = set(_page_keys(env, run_id).values())
+    assert len(keys) == 3
+    log: list[tuple[str, str]] = []
+    real = source_check.embedded_products
+
+    def noted(html: str) -> list[dict[str, Any]]:
+        found = real(html)
+        log.append(("parsed", str(len(found))))
+        return found
+
+    monkeypatch.setattr(source_check, "embedded_products", noted)
+    code, report = _validate(env, run_id, _Recorder(env["storage"], keys, log))
+    kinds = [k for k, _ in log]
+    assert kinds == ["read", "parsed"] * 3, kinds
+    assert code == 6 and report["contract"]["problems"] == {"image host": 60}  # the mock site's picture host
+    assert report["source_check"]["summary"]["verified"] == 60
+    caps = report["captures"]
+    counts = (caps["ok"], caps["missing"], caps["corrupted"], caps["unreadable"], caps["not_named"])
+    assert counts == (60, 0, 0, 0, 0), caps
+    assert report["resources"]["sources_read"] >= 3 and report["mismatches"]["total"] == 0
+
+
+def test_or20_a_stored_page_missing_or_altered_after_the_run_rejects_its_export_and_names_the_records(
+    env: dict[str, Any], settings: Settings
+) -> None:
+    """Expected to FAIL on 1.10.0rc5 (a missing page stops the command with an exception; an altered
+    page's records are only reported unverified). A record whose capture is gone is ``missing``; one whose
+    capture's bytes no longer have the hash the run recorded is ``corrupted``; both are named and the export
+    rejected. (The run's stored product responses still state every record's prices: the source values are
+    verified from them.)"""
+    run_id = _validated_run(env, settings)
+    pages = _page_keys(env, run_id)
+    root = env["tmp"] / "data"
+    two = next(k for u, k in pages.items() if u.endswith("page=2"))
+    three = next(k for u, k in pages.items() if u.endswith("page=3"))
+    (root / two).unlink()
+    html = gzip.decompress((root / three).read_bytes()).decode("utf-8")
+    (root / three).write_bytes(gzip.compress(html.replace("</body>", "<!-- altered --></body>").encode()))
+    code, report = _validate(env, run_id)
+    assert code == 6
+    caps = report["captures"]
+    assert (caps["ok"], caps["missing"], caps["corrupted"]) == (24, 24, 12), caps
+    assert {p["key"] for p in caps["problems"]} == {two, three} and caps["problems_total"] == 36
+
+
+def _priced_record(env: dict[str, Any], run_id: str) -> tuple[list[dict[str, Any]], int]:
+    root = env["tmp"] / "data"
+    [key] = [k for k in _keys_of(env, run_id) if k.endswith("/products.json")]
+    records = json.loads((root / key).read_bytes())
+    i = next(i for i, r in enumerate(records) if r.get("regular_price"))
+    return records, i
+
+
+def _keys_of(env: dict[str, Any], run_id: str) -> list[str]:
+    root = env["tmp"] / "data"
+    return [str(p.relative_to(root).as_posix()) for p in root.rglob("*") if run_id in p.as_posix()]
+
+
+def test_control_a_record_whose_price_differs_from_its_stored_page_is_a_mismatch(
+    env: dict[str, Any], settings: Settings
+) -> None:
+    """Before and after 1.10.0rc6: a record whose regular price differs from the price the stored page's own
+    data states for the store is a mismatch, and the export is rejected. The products file is re-sealed in its
+    manifest, so only the value differs."""
+    run_id = _validated_run(env, settings)
+    records, i = _priced_record(env, run_id)
+    records[i]["regular_price"] = f"{float(records[i]['regular_price']) + 1:.2f}"
+    _rewrite_export(env, run_id, "products.json", json.dumps(records, indent=2).encode("utf-8"))
+    code, report = _validate(env, run_id)
+    assert code == 6 and report["manifest"]["problems"] == []
+    assert report["source_check"]["summary"]["mismatch"] == 1
+
+
+def test_or20_a_mismatch_names_the_record_its_values_and_the_stored_page_that_states_otherwise(
+    env: dict[str, Any], settings: Settings
+) -> None:
+    """Expected to FAIL on 1.10.0rc5 (it reports a count of mismatches by field, not the records). Each
+    mismatch names the record, the values it states, the values its stored source states and that source."""
+    run_id = _validated_run(env, settings)
+    records, i = _priced_record(env, run_id)
+    stated = records[i]["regular_price"]
+    records[i]["regular_price"] = f"{float(stated) + 1:.2f}"
+    _rewrite_export(env, run_id, "products.json", json.dumps(records, indent=2).encode("utf-8"))
+    code, report = _validate(env, run_id)
+    assert code == 6
+    [m] = report["mismatches"]["first_200"]
