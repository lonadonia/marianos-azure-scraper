From abc47185658554a8c8cabaa2d82d5b2e7548f9e5 Mon Sep 17 00:00:00 2001
From: Hamza <155834495+lonadonia@users.noreply.github.com>
Date: Tue, 17 Nov 2026 05:30:20 +0000
Subject: [PATCH 6/6] marianos-azure-headless next: OR-23, a page that fails
 again once the run has been resumed at it leaves its listing incomplete and
 the run goes on (bounded: no run stop at every resume)

---
 .../collection/oxylabs_live.py                | 43 ++++++++++++++++---
 1 file changed, 38 insertions(+), 5 deletions(-)

diff --git a/headless/marianos-azure-headless/src/marianos_headless/collection/oxylabs_live.py b/headless/marianos-azure-headless/src/marianos_headless/collection/oxylabs_live.py
index 08898dc..2c577ad 100644
--- a/headless/marianos-azure-headless/src/marianos_headless/collection/oxylabs_live.py
+++ b/headless/marianos-azure-headless/src/marianos_headless/collection/oxylabs_live.py
@@ -108,6 +108,16 @@ SEARCH_ROUTE_REASON = (
 )
 
 
+class ListingUnread(Exception):
+    """OR-23: a page of the listing the provider did not bring once more after the run had stopped at it (more
+    failed answers for the page than a task's attempts): the listing stays incomplete, with this reason, and the
+    run goes on instead of stopping there again at every resume."""
+
+    def __init__(self, reason: str) -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
 @dataclass(frozen=True)
 class PageContext:
     """The response being recorded: what the page's row needs inside the products' transaction."""
@@ -1005,9 +1015,14 @@ class OxylabsCollector(LiveCollector):
         if not await self.ensure_session(ctx, node):
             state.status, state.reason = "SKIPPED", "robots.txt does not allow this listing's page"
             return self._finish_node(node, state)
-        if self.route == "search":
-            return await self.read_search(ctx, node, state)
-        return await self.read_listing(ctx, node, state)
+        try:
+            if self.route == "search":
+                return await self.read_search(ctx, node, state)
+            return await self.read_listing(ctx, node, state)
+        except ListingUnread as exc:
+            # OR-23: bounded across resumes; the pages read before it stay counted, the listing is not complete.
+            state.status, state.reason = "INCOMPLETE", exc.reason
+            return self._finish_node(node, state)
 
     # -- the page loop --------------------------------------------------------------------------------------
 
@@ -1237,7 +1252,12 @@ class OxylabsCollector(LiveCollector):
     def _unread(self, ctx: TaskContext, node: Node, page: int, why: str) -> NoReturn:
         """The page stays unread and the listing unfinished. The task waits and comes back (the run's bounded
         retries); once they are spent, or when pages keep failing on any listing, the run stops resumably, and
-        the resume starts at this page."""
+        the resume starts at this page.
+
+        OR-23: bounded across resumes. A page that fails again once the run has been resumed (more failed answers
+        for it in this run than a task's attempts) leaves its listing incomplete, with the reason, and the run
+        goes on: it no longer stops the run at every resume, which made a run holding a page the provider never
+        brings endless (Hard Cider 08194 in R7). Pages failing in a row on any listings still stop the run."""
         self.failed_in_a_row += 1
         text = f"{node.url}: page {page} not read: {why}"[:600]
         if self.failed_in_a_row >= MAX_FAILED_LISTINGS_IN_A_ROW:
@@ -1246,10 +1266,23 @@ class OxylabsCollector(LiveCollector):
                 f"{self.failed_in_a_row} pages in a row not read; last: {text}",
                 resumable=True,
             )
-        if ctx.lease.attempts >= self.settings.retries.max_attempts_per_task:
+        limit = self.settings.retries.max_attempts_per_task
+        failed = self._failed_answers(node, page)
+        if failed > limit:
+            raise ListingUnread(
+                f"{text}; the provider brought no page in {failed} answers, the last after the run had stopped "
+                f"at this page and been resumed: the listing stays incomplete"
+            )
+        if ctx.lease.attempts >= limit:
             raise RunStop(StopCode.PROVIDER_ERROR, text, resumable=True)
         raise TaskFailure(FailureKind.TRANSIENT, text)
 
+    def _failed_answers(self, node: Node, page: int) -> int:
+        """OR-23: the provider's failed answers for this page of the listing in this run (one row per attempt)."""
+        with self.factory() as s:
+            rows = pagination.rows_of(s, self.run_id, node.category_source_id, node.taxonomy_id, self._pkey(node))
+            return sum(1 for r in rows if r.requested_page == page and r.state == "failed")
+
     # -- requests set aside and asked again (release 1.10.0, C1; collection.reask) -------------------------
 
     def _key(self, node: Node, page: int) -> reask.Key:
-- 
