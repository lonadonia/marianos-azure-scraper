+        assert pages[0] == (1, "completed", "new")
+        assert all(p == (2, "refused", "malformed") for p in pages[1:]) and len(pages) == 1 + asked
+        assert len(_upcs(s, run_id)) == 24
+        cov = _coverage(s, run_id)
+        assert cov is None or cov.status != "DONE"
