+# -- two lanes, both completion orders, against one lane -----------------------------------------------------
+
+
+class Gate:
+    """A fake Web API ``site`` holding one kind of request until another has been answered (or 10 s passed).
+
+    ``product_after_other``: a named product's own page waits for the other lane's listing (R7's order);
+    ``other_after_product``: the other lane's listing waits for the named product's page."""
+
+    def __init__(self, site: Any, other: str, order: str) -> None:
+        self.site, self.other, self.order = site, other, order
+        self.answered = {"product": asyncio.Event(), "other": asyncio.Event()}
+        self.waited: list[bool] = []
+
+    @property
+    def requests(self) -> list[dict[str, Any]]:
+        return list(self.site.requests)
+
+    def _is_other(self, body: dict[str, Any]) -> bool:
+        return self.other in body.get("url", "") or self.other == body.get("query")
+
+    async def __call__(self, request: httpx.Request) -> httpx.Response:
+        body = json.loads(request.content)
+        product = "/p/" in body.get("url", "")
+        wait_for = (
+            "other"
+            if product and self.order == "product_after_other"
+            else "product"
+            if self._is_other(body) and self.order == "other_after_product"
+            else None
+        )
+        if wait_for is not None:
+            try:
+                await asyncio.wait_for(self.answered[wait_for].wait(), 10)
+                self.waited.append(True)
+            except TimeoutError:
+                self.waited.append(False)
+        response = self.site(request)
+        if product:
+            self.answered["product"].set()
+        if self._is_other(body):
+            self.answered["other"].set()
+        return response
+
+
+class ProductPagesFail:
+    """``site``, with every product page answered as a provider failure (as ``test_lanes_or24``): the named
+    product's page is asked for once and its terms stay unread, for one lane and two alike."""
+
+    def __init__(self, site: Any) -> None:
+        self.site = site
+
+    @property
+    def requests(self) -> list[dict[str, Any]]:
+        return list(self.site.requests)
+
+    def __call__(self, request: httpx.Request) -> httpx.Response:
+        if "/p/" in json.loads(request.content).get("url", ""):
+            return httpx.Response(500, json={"detail": "REQUEST_FAILED_AFTER_TOO_MANY_RETRIES"})
+        return self.site(request)
+
+
+def fingerprint(e: dict[str, Any], run_id: str) -> dict[str, Any]:
+    """What a run kept, without its own identifiers: products, placements, page hashes, exclusions, export."""
+    with e["factory"]() as s:
+        recs = {
+            r.upc: (r.status, sorted(r.reasons or []), json.dumps(r.record, sort_keys=True, default=str))
+            for r in s.scalars(select(RecordRow).where(RecordRow.run_id == run_id))
+        }
+        members = sorted(
+            (m.upc, m.taxonomy_id, m.page_offset, m.position, m.via, m.placement)
+            for m in s.scalars(select(MembershipRow).where(MembershipRow.run_id == run_id))
+        )
+        pages = sorted(
+            (r.taxonomy_id, r.requested_page, r.state, r.response_sha256, tuple(r.identities or []))
+            for r in s.scalars(select(ListingPage).where(ListingPage.run_id == run_id))
+            if r.state == "completed"
+        )
+        holes = incoherent_pages(s, run_id)
+        report = reconciliation.reconciliation(s, run_id)
+    lines = {
+        x["listing_id"]: (x["status"], x["unique_identities"], x["unresolved_gap"])
+        for x in report["listings"]
+    }
+    exported = sorted(json.dumps(x, sort_keys=True) for x in export_file(e, run_id, "products.json"))
+    return {
+        "upcs": sorted(recs),
+        "records": recs,
+        "memberships": members,
+        "pages": pages,
+        "exclusions": {u: v[:2] for u, v in recs.items() if v[0] != "valid"},
+        "coverage": lines,
+        "export_sha256": hashlib.sha256("\n".join(exported).encode()).hexdigest(),
+        "incoherent_pages": holes,
+    }
+
+
+@pytest.mark.parametrize("order", ["product_after_other", "other_after_product"])
+def test_lanes_two_lanes_in_either_order_keep_what_one_lane_keeps(
+    migrated_engine: Engine, tmp_path: Any, private_label: PrivateLabelConfig, settings: Settings, order: str
+) -> None:
+    first, other = products(30, "0003800"), products(10, "0004400")
+    named = first[26].upc  # on the first listing's page 2: its own page is asked before the page's records
+    runs: dict[str, dict[str, Any]] = {}
+    e = c1.make_env(migrated_engine, tmp_path, private_label)
+    for lanes in (1, 2):  # the same store, one run after the other, on identical pages and clocks
+        clock = Clock()
+        site = ProductPagesFail(C1Site({"03001": first, "03002": other}, clock))
+        api: Any = Gate(site, "/03002", order) if lanes == 2 else site
+        run_id, status = c1.run(
+            e, settings, api, clock, listings=("03001", "03002"), lanes=lanes, product_term_upcs=[named]
+        )
+        runs[f"lanes_{lanes}"] = {
+            "run": run_id,
+            "status": status,
+            "waited": getattr(api, "waited", None),
+            **fingerprint(e, run_id),
+        }
+    one, two = runs["lanes_1"], runs["lanes_2"]
+    shown = ("status", "waited", "coverage", "export_sha256", "incoherent_pages", "upcs")
+    evidence(f"rc7_lanes_{order}", {k: {x: v[x] for x in shown} for k, v in runs.items()})
+    assert two["waited"] == [True]  # the lanes interleaved in the order named
+    assert one["incoherent_pages"] == two["incoherent_pages"] == []
+    for key in ("upcs", "records", "memberships", "pages", "exclusions", "coverage", "export_sha256"):
+        assert one[key] == two[key], key
+    assert one["coverage"]["03001"] == ("DONE", 30, 0) and one["coverage"]["03002"] == ("DONE", 10, 0)
+
+
+def test_control_on_the_search_route_the_other_lane_waiting_for_the_product_page_loses_nothing(
+    vh_env: dict[str, Any], settings: Settings
+) -> None:
+    """The order R7 did not see (the other lane's search waits for the named product's page); the order R7 saw
+    is ``test_lanes_or24``."""
+    from marianos_headless.collection.config import Limits
+
+    terms._ceiling(vh_env["factory"], 20)
+    api = Gate(terms.FakeTermsApi(), "Bars & Toaster Pastries", "other_after_product")
+    run_id = terms._run(
+        vh_env,
+        settings,
+        api,  # type: ignore[arg-type]
+        read=False,
+        limits=Limits(max_concurrent_listings=2, product_term_upcs=[terms.PURINA.upc]),
+    )
+    assert api.waited == [True]
+    with vh_env["factory"]() as s:
+        recorded = {r.upc for r in s.scalars(select(RecordRow).where(RecordRow.run_id == run_id))}
+        cereal = {terms.PURINA.upc, terms.LAMB.upc, terms.ENERGIZER.upc, terms.TEMPTATIONS.upc}
+        assert cereal | {terms.PLAIN.upc} <= recorded, sorted(cereal - recorded)
+        pages = sorted(
+            (r.taxonomy_id, r.state, r.new_count)
+            for r in s.scalars(select(ListingPage).where(ListingPage.run_id == run_id))
+        )
+        assert pages == [("03001", "completed", 4), ("03002", "completed", 1)]
+        assert incoherent_pages(s, run_id) == []
+
+
+# -- a worker killed between two lanes' pages, then resumed --------------------------------------------------
+
+
+def test_control_a_two_lane_worker_killed_mid_run_leaves_every_counted_page_whole_and_resume_completes_it(
+    migrated_engine: Engine, tmp_path: Any, private_label: PrivateLabelConfig, settings: Settings
+) -> None:
+    listings = {"03001": [60], "03002": [30, "0003805"]}
+    e = c1.make_env(migrated_engine, tmp_path, private_label)
+    clock = Clock()
+    pipe = c1.pipe_of(e, settings)
+    run_id = c1.plan(e, pipe, c1.nodes_of(e, tuple(listings)))
+    args = {
+        "db": migrated_engine.url.render_as_string(hide_password=False),
+        "data": str(tmp_path / "data"),
+        "run": run_id,
+        "now": clock.now().isoformat(),
+        "listings": listings,
+        "listing": "03002",
+        "page": 2,
+        "nth": 1,
+        "lanes": 2,
+        "max_reasks": None,
+    }
+    p = subprocess.run(
+        [sys.executable, "-m", "tests.c1_site", json.dumps(args)],
+        cwd=c1.ROOT,
+        env=dict(os.environ),
+        capture_output=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=300,
+        check=False,
+    )
+    assert p.returncode == 137, (p.returncode, p.stdout[-1500:], p.stderr[-1500:])
+    with e["factory"]() as s:
+        killed = incoherent_pages(s, run_id)
+        counted = sorted(
+            (r.taxonomy_id, r.requested_page)
+            for r in s.scalars(
+                select(ListingPage).where(ListingPage.run_id == run_id, ListingPage.state == "completed")
+            )
+        )
+    clock.t += timedelta(seconds=1)
+    site = C1Site({k: products(*v) for k, v in listings.items()}, clock)
+    _, status = c1.run(e, settings, site, clock, run_id=run_id, lanes=2, max_reasks=None)
+    resumed = fingerprint(e, run_id)
+    evidence(
+        "rc7_two_lane_kill_then_resume",
+        {
+            "counted_at_kill": counted,
+            "incoherent_at_kill": killed,
+            "status": status,
+            "coverage": resumed["coverage"],
+        },
+    )
+    assert killed == []  # every page counted when the worker died has its products, all of them
+    assert ("03002", 2) not in counted and ("03001", 1) in counted
+    assert all(site.times(k, n) == 0 for k, n in counted)  # a counted page is never asked for again
+    assert resumed["incoherent_pages"] == []
+    assert resumed["coverage"]["03001"] == ("DONE", 60, 0) and resumed["coverage"]["03002"] == ("DONE", 30, 0)
+    assert len(resumed["upcs"]) == 90
diff --git a/headless/marianos-azure-headless/tests/unit/test_contract_csv_rc7.py b/headless/marianos-azure-headless/tests/unit/test_contract_csv_rc7.py
new file mode 100644
index 0000000..b6ae715
--- /dev/null
+++ b/headless/marianos-azure-headless/tests/unit/test_contract_csv_rc7.py
@@ -0,0 +1,56 @@
+"""Release 1.10.0rc7: ``validate-export --file`` reads the client's ``products.csv`` as well as
+``products.json``.
+
+Until 1.10.0rc6 a CSV was read as JSON and refused with a decoding error (exit 2), so the file the client
+receives could not be checked offline by itself. The CSV here is written by the export's own writer
+(``products_csv_bytes``: UTF-8 with a byte order mark, CRLF) from REAL records of a stored run."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from marianos_headless.checks import contract
+from marianos_headless.core.schema import OUTPUT_FIELDS
+from marianos_headless.publishing.exports import products_csv_bytes
+from tests.conftest import CAPTURES
+
+RUN = CAPTURES / "run_01M5CSS9_20261020"
+
+
+def _write(tmp: Path, data: bytes, name: str = "products.csv") -> Path:
+    p = tmp / name
+    p.write_bytes(data)
+    return p
+
+
+def test_the_csv_and_the_json_of_one_export_pass_the_same_contract(tmp_path: Path) -> None:
+    records = json.loads((RUN / "products.json").read_text("utf-8"))
+    as_csv = contract.check(_write(tmp_path, products_csv_bytes(records)))
+    as_json = contract.check(RUN / "products.json")
+    assert as_csv["passed"] and as_json["passed"]
+    for k in ("rows", "problems", "duplicate_upc", "duplicate_url", "leading_zero_upcs", "populated"):
+        assert as_csv[k] == as_json[k], k
+
+
+def test_a_csv_whose_leading_zeros_were_lost_fails(tmp_path: Path) -> None:
+    records = json.loads((RUN / "products.json").read_text("utf-8"))
+    zeros = [r for r in records if r["upc"].startswith("0")]
+    assert zeros
+    damaged = [dict(r, upc=r["upc"].lstrip("0")) if r is zeros[0] else r for r in records]
+    report = contract.check(_write(tmp_path, products_csv_bytes(damaged)))
+    assert not report["passed"] and report["problems"]["upc not 13 digits"] == 1
+
+
+def test_a_csv_with_another_header_or_a_short_row_fails(tmp_path: Path) -> None:
+    records = json.loads((RUN / "products.json").read_text("utf-8"))
+    body = products_csv_bytes(records).decode("utf-8-sig").split("\r\n")
+    head = body[0].split(",")
+    head[0], head[1] = head[1], head[0]
+    swapped = "\r\n".join([",".join(head), *body[1:]]).encode("utf-8")
+    report = contract.check(_write(tmp_path, swapped, "swapped.csv"))
+    assert not report["passed"] and report["problems"]["csv header"] == 1
+    short = "\r\n".join([body[0], body[1].rsplit(",", 1)[0], *body[2:]]).encode("utf-8")
+    report = contract.check(_write(tmp_path, short, "short.csv"))
+    assert not report["passed"] and report["problems"]["row width"] == 1
+    assert next(iter(OUTPUT_FIELDS)) == "zipcode"
diff --git a/headless/marianos-azure-headless/tests/unit/test_route_audit_rc7.py b/headless/marianos-azure-headless/tests/unit/test_route_audit_rc7.py
new file mode 100644
index 0000000..298fb23
--- /dev/null
+++ b/headless/marianos-azure-headless/tests/unit/test_route_audit_rc7.py
@@ -0,0 +1,258 @@
+"""Release 1.10.0rc7: a listing's verdict from the products actually accounted for (``route_audit``).
+
+SYNTHETIC evidence shaped like the full run R7 (2026-11-17): Cat Food 27021 (234 of 234, the positive
+control), Dog Food 27017 (224 reported, page 7's 24 products without a record) and Cat Treats 27022 (52
+reported, page 2's 20 products without a record). Until 1.10.0rc6 the coverage file reported both short
+listings DONE with no gap (the larger of the pages' identities and the cursor's count); here they are
+INCOMPLETE with the products named.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+
+from marianos_headless.collection import route_audit as ra
+from marianos_headless.collection.route_audit import PageEvidence, RecordFact, RouteEvidence
+
+
+def upcs(prefix: str, n: int) -> list[str]:
+    # 13 digits with leading zeros, as the source writes them (never cast to a number).
+    return [f"00{prefix[:5]}{i:06d}" for i in range(n)]
+
+
+def pages_of(ids: Sequence[str], size: int = 24, prefix: str = "f") -> tuple[PageEvidence, ...]:
+    out = []
+    for k in range(0, len(ids), size):
+        n = k // size + 1
+        out.append(
+            PageEvidence(
+                page=n, identities=tuple(ids[k : k + size]), fetch_id=f"{prefix}{n}", store_bound=True
+            )
+        )
+    return tuple(out)
+
+
+def placed(ids: Iterable[str], fetch: str | None = None) -> frozenset[tuple[str, str | None]]:
+    return frozenset((u, fetch) for u in ids)
+
+
+def route(
+    key: str,
+    ids: Sequence[str],
+    *,
+    total: int | None,
+    status: str = "DONE",
+    recorded: Iterable[str] | None = None,
+    **kw: object,
+) -> RouteEvidence:
+    pages = pages_of(ids, prefix=key + "-")
+    rec = list(ids if recorded is None else recorded)
+    by_upc = {u: p.fetch_id for p in pages for u in p.identities}
+    placements = frozenset((u, by_upc.get(u)) for u in rec)
+    args: dict[str, object] = {"pages": pages, "placements": placements, "total": total}
+    args.update(kw)
+    return RouteEvidence(key=key, cursor_status=status, **args)  # type: ignore[arg-type]
+
+
+def valid(ids: Iterable[str], node: str = "") -> dict[str, RecordFact]:
+    return {u: RecordFact("valid", (), node) for u in ids}
+
+
+def test_the_positive_control_cat_food_reconciles() -> None:
+    ids = upcs("27021", 234)
+    v = ra.audit([route("27021", ids, total=234)], valid(ids, "27021"))["27021"]
+    assert (v.status, len(v.accounted), v.missing, v.unexpected, v.pages_counted) == ("DONE", 234, {}, (), 10)
+    assert v.fresh_valid == 234 and v.cross_listed == 0
+    assert all(u.startswith("00") and len(u) == 13 for u in v.accounted)
+
+
+def test_dog_food_page_7_without_records_is_incomplete_with_its_products_named() -> None:
+    ids = upcs("27017", 224)
+    lost = ids[6 * 24 : 7 * 24]
+    kept = [u for u in ids if u not in lost]
+    v = ra.audit([route("27017", ids, total=224, recorded=kept)], valid(kept))["27017"]
+    assert v.status == "INCOMPLETE" and v.cursor_status == "DONE"
+    assert (len(v.accounted), len(v.missing), list(v.missing_by_page)) == (200, 24, [7])
+    assert set(v.missing_by_page[7]) == set(lost) and set(v.missing.values()) == {ra.MISSING_NO_RECORD}
+    assert "24 of the 224 products" in v.reason and "page 7: 24" in v.reason
+
+
+def test_cat_treats_page_2_short_by_20_is_incomplete() -> None:
+    ids = upcs("27022", 52)
+    lost = ids[24 + 4 : 48]  # 20 of page 2's 24 (4 recorded: placed under the listing from that page)
+    kept = [u for u in ids if u not in lost]
+    v = ra.audit([route("27022", ids, total=52, recorded=kept)], valid(kept))["27022"]
+    assert (v.status, len(v.accounted), len(v.missing), list(v.missing_by_page)) == (
+        "INCOMPLETE",
+        32,
+        20,
+        [2],
+    )
+
+
+def test_one_product_short_223_of_224_is_never_done() -> None:
+    # rc6: a ratio of 0.9955 is above both thresholds (0.98 warn, 0.90 fail): G3 passed and the run published.
+    ids = upcs("27017", 224)
+    kept = ids[:-1]
+    v = ra.audit([route("27017", ids, total=224, recorded=kept)], valid(kept))["27017"]
+    assert (v.status, len(v.accounted), list(v.missing)) == ("INCOMPLETE", 223, [ids[-1]])
+
+
+def test_equal_counts_with_a_substituted_upc_are_not_a_match() -> None:
+    ids = upcs("27017", 224)
+    other = "0099999999999"
+    kept = [*ids[:-1], other]  # 224 records placed under the listing, one of them a product no page lists
+    r = route("27017", ids, total=224, recorded=ids[:-1])
+    r = RouteEvidence(**{**r.__dict__, "placements": r.placements | {(other, "27017-10")}})
+    v = ra.audit([r], valid(kept))["27017"]
+    assert v.status == "INCOMPLETE"
+    assert (list(v.missing), v.unexpected) == ([ids[-1]], (other,))
+    assert "placement(s) under the listing for products none of its counted pages lists" in v.reason
+
+
+def test_overlapping_subdivisions_complete_only_by_their_union() -> None:
+    a, b = upcs("10001", 200), upcs("10002", 150)
+    shared = a[:50]
+    b = [*shared, *b[50:]]  # 50 products in both subdivisions
+    parent_total = 300
+    records = valid({*a, *b})
+    kids = [
+        route("1000101", a, total=200, parent="10001"),
+        route("1000102", b, total=150, parent="10001"),
+    ]
+    parent = RouteEvidence(key="10001", cursor_status="PARTITIONED", total=parent_total)
+    v = ra.audit([parent, *kids], records)["10001"]
+    assert (v.status, len(v.union_accounted)) == ("DONE", 300)
+    # The same subdivisions sum to 350 >= 310, but their union is 300: never complete by a sum.
+    parent = RouteEvidence(key="10001", cursor_status="PARTITIONED", total=310)
+    v = ra.audit([parent, *kids], records)["10001"]
+    assert v.status == "INCOMPLETE" and "300 distinct products (their union) of the 310" in v.reason
+
+
+def test_a_subdivision_short_of_its_products_keeps_the_parent_incomplete() -> None:
+    a, b = upcs("10001", 200), upcs("10002", 100)
+    kept_b = b[:-1]
+    kids = [
+        route("1000101", a, total=200, parent="10001"),
+        route("1000102", b, total=100, parent="10001", recorded=kept_b),
+    ]
+    out = ra.audit(
+        [RouteEvidence(key="10001", cursor_status="PARTITIONED", total=300), *kids], valid([*a, *kept_b])
+    )
+    assert out["1000102"].status == "INCOMPLETE"
+    assert out["10001"].status == "INCOMPLETE" and "1000102 INCOMPLETE" in out["10001"].reason
+
+
+def test_a_brand_reading_whose_filter_the_page_did_not_bind_counts_nothing() -> None:
+    # Its pages were refused (verdict unbound, never counted): the reading has no counted page.
+    brand = RouteEvidence(
+        key="08120~0123456789abcdef01234567", cursor_status="DONE", parent="08120", total=40
+    )
+    whole = upcs("08120", 260)
+    parent = route("08120", whole[:250], total=260, status="PARTITIONED")
+    out = ra.audit([parent, brand], valid(whole[:250]))
+    assert out[brand.key].status == "INCOMPLETE" and "0 distinct products are accounted for of the 40" in (
+        out[brand.key].reason
+    )
+    assert out["08120"].status == "INCOMPLETE"
+
+
+def test_a_page_not_shown_for_the_store_is_not_counted_evidence() -> None:
+    ids = upcs("27017", 48)
+    r = route("27017", ids, total=48)
+    wrong = (r.pages[0], PageEvidence(**{**r.pages[1].__dict__, "store_bound": False}))
+    v = ra.audit([RouteEvidence(**{**r.__dict__, "pages": wrong})], valid(ids))["27017"]
+    assert v.status == "INCOMPLETE" and "page(s) 2 were not shown for the run's store" in v.reason
+
+
+def test_an_empty_listing_needs_a_page_of_the_store_stating_zero() -> None:
+    without = RouteEvidence(key="27029", cursor_status="EMPTY", total=0)
+    with_page = RouteEvidence(key="27027", cursor_status="EMPTY", total=0, zero_result=True)
+    out = ra.audit([without, with_page], {})
+    assert (
+        out["27029"].status == "INCOMPLETE" and "without a page of the store stating 0" in out["27029"].reason
+    )
+    assert out["27027"].status == "EMPTY"
+
+
+def test_a_repeated_page_counted_twice_does_not_make_up_the_total() -> None:
+    ids = upcs("27017", 48)
+    first = PageEvidence(page=1, identities=tuple(ids[:24]), fetch_id="a", store_bound=True)
+    again = PageEvidence(page=2, identities=tuple(ids[:24]), fetch_id="b", store_bound=True)
+    r = RouteEvidence(
+        key="27017", cursor_status="DONE", total=48, pages=(first, again), placements=placed(ids[:24], "a")
+    )
+    v = ra.audit([r], valid(ids[:24]))["27017"]
+    assert (v.status, v.duplicates, len(v.accounted)) == ("INCOMPLETE", 24, 24)
+    assert "24 distinct products are accounted for of the 48" in v.reason
+
+
+def test_a_total_that_changed_while_reading_is_named() -> None:
+    ids = upcs("27017", 224)
+    r = route("27017", ids, total=226, totals_seen=(224, 226))
+    v = ra.audit([r], valid(ids))["27017"]
+    assert v.status == "INCOMPLETE" and "the source's total changed while reading: 224, 226" in v.reason
+
+
+def test_carried_cross_listed_excluded_and_sponsored_stay_distinct() -> None:
+    ids = upcs("27017", 24)
+    sponsored = ("0001111111111",)
+    pages = (
+        PageEvidence(page=1, identities=tuple(ids), sponsored=sponsored, fetch_id="p1", store_bound=True),
+    )
+    records: dict[str, RecordFact] = {
+        **valid(ids[:20], "27017"),
+        ids[20]: RecordFact("valid", (), "27018"),  # recorded under another listing, placed here too
+        ids[21]: RecordFact("excluded", ("APPROXIMATE_WEIGHT",), "27017"),
+        ids[22]: RecordFact("historical", ("CARRIED_FORWARD",), "27017"),  # carried: not this run's
+        ids[23]: RecordFact("excluded", (), "27017"),  # excluded with no reason: never an exclusion
+    }
+    r = RouteEvidence(key="27017", cursor_status="DONE", total=24, pages=pages, placements=placed(ids, "p1"))
+    v = ra.audit([r], records)["27017"]
+    assert v.status == "INCOMPLETE"
+    assert (v.fresh_valid, v.cross_listed, list(v.excluded), v.sponsored) == (21, 1, [ids[21]], sponsored)
+    assert v.missing == {ids[22]: ra.MISSING_CARRIED, ids[23]: ra.MISSING_UNEXPLAINED}
+
+
+def test_a_record_with_no_placement_under_the_listing_does_not_count_here() -> None:
+    # Seen elsewhere in the run: counts here only with this run's placement under this listing.
+    ids = upcs("27017", 24)
+    r = RouteEvidence(
+        key="27017",
+        cursor_status="DONE",
+        total=24,
+        pages=pages_of(ids, prefix="p"),
+        placements=placed(ids[:23], "p1"),
+    )
+    v = ra.audit([r], valid(ids, "27018"))["27017"]
+    assert v.status == "INCOMPLETE" and v.missing == {ids[23]: ra.MISSING_NO_PLACEMENT}
+
+
+def test_a_placement_made_from_another_listings_page_is_not_unexpected() -> None:
+    ids = upcs("27017", 24)
+    foreign = "0005555555555"
+    r = RouteEvidence(
+        key="27017",
+        cursor_status="DONE",
+        total=24,
+        pages=pages_of(ids, prefix="p"),
+        placements=placed(ids, "p1") | {(foreign, "other-listing-fetch")},
+        fetches=frozenset({"p1"}),
+    )
+    v = ra.audit([r], valid([*ids, foreign]))["27017"]
+    assert (v.status, v.unexpected, v.from_other_listings) == ("DONE", (), 1)
+
+
+def test_an_incomplete_listing_stays_incomplete_and_the_summary_names_the_downgrades() -> None:
+    ids = upcs("27017", 224)
+    kept = ids[:200]
+    out = ra.audit(
+        [
+            route("27017", ids, total=224, recorded=kept),
+            route("27021", upcs("27021", 24), total=234, status="INCOMPLETE", reason="search route"),
+        ],
+        valid([*kept, *upcs("27021", 24)]),
+    )
+    assert out["27021"].status == "INCOMPLETE" and out["27021"].reason == "search route"
+    s = ra.summary(out)
+    assert s["read_to_end_but_not_accounted"] == ["27017"] and s["missing_identities"] == 24
