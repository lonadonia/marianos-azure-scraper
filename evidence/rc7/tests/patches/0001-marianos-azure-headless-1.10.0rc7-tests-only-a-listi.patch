+# -- what the tests read -------------------------------------------------------------------------------------
+
+
+def incoherent_pages(s: Any, run_id: str) -> list[tuple[str, int, list[str]]]:
+    """An oracle of its own (not the collector's code): every completed page whose listed products are not
+    each kept by the run as a record placed under the page's listing."""
+    recs = set(s.scalars(select(RecordRow.upc).where(RecordRow.run_id == run_id)))
+    placed = {
+        (u, t)
+        for u, t in s.execute(
+            select(MembershipRow.upc, MembershipRow.taxonomy_id).where(
+                MembershipRow.run_id == run_id, MembershipRow.coupon_id.is_(None)
+            )
+        ).all()
+    }
+    out = []
+    for r in s.scalars(
+        select(ListingPage)
+        .where(ListingPage.run_id == run_id, ListingPage.state == "completed")
+        .order_by(ListingPage.taxonomy_id, ListingPage.requested_page)
+    ):
+        lost = [u for u in (r.identities or []) if u not in recs or (u, r.taxonomy_id) not in placed]
+        if lost:
+            out.append((r.taxonomy_id, r.requested_page, lost))
+    return out
+
+
+def published(e: dict[str, Any]) -> dict[str, Any] | None:
+    """The published dataset, byte for byte: the pointer, ``latest.json``, its manifest and products."""
+    from marianos_headless.db.models import PublicationPointer, Store
+
+    with e["factory"]() as s:
+        store = s.scalar(select(Store).where(Store.key == TARGET))
+        ptr = s.get(PublicationPointer, store.id) if store is not None else None
+        if ptr is None:
+            return None
+        state = {"publication_id": ptr.publication_id, "version": ptr.version}
+    latest = e["storage"].get_bytes(latest_key(TARGET))
+    body = json.loads(latest)
+    manifest = e["storage"].get_bytes(body["manifest_key"])
+    products_file = e["storage"].get_bytes(json.loads(manifest)["files"]["products.json"]["key"])
+    return {
+        **state,
+        "published_run": body["run_id"],
+        "latest_json_sha256": hashlib.sha256(latest).hexdigest(),
+        "manifest_sha256": hashlib.sha256(manifest).hexdigest(),
+        "products_sha256": hashlib.sha256(products_file).hexdigest(),
+    }
+
+
+def export_file(e: dict[str, Any], run_id: str, name: str) -> Any:
+    with e["factory"]() as s:
+        manifest = s.scalar(select(ExportRow).where(ExportRow.run_id == run_id, ExportRow.kind == "manifest"))
+        assert manifest is not None
+        art = s.get(Artifact, manifest.artifact_id)
+        assert art is not None
+        key = str(art.key)
+    files = json.loads(e["storage"].get_bytes(key))["files"]
+    return json.loads(e["storage"].get_bytes(files[name]["key"]))
+
+
+def evidence(name: str, data: dict[str, Any]) -> None:
+    out = os.environ.get("PUBLICATION_EVIDENCE_DIR")
+    if not out:
+        return
+    os.makedirs(out, exist_ok=True)
+    body = {"case": name, "evidence_type": c1.SYNTHETIC + "; the lost record is injected", **data}
+    with open(os.path.join(out, f"{name}.json"), "wb") as f:
+        f.write((json.dumps(body, indent=1, default=str, ensure_ascii=False) + "\n").encode("utf-8"))
+
+
+def drop_records(monkeypatch: pytest.MonkeyPatch, upcs: set[str]) -> None:
+    """The injected fault: the named cards of a page are never recorded while the page counts as read."""
+    original = live.LiveCollector.record_step
+
+    def record_step(self: Any, s: Any, node: Any, fetch: Any, view: Any, state: Any, step: int) -> Any:
+        kept = [c for c in view.cards if c.upc not in upcs]
+        return original(self, s, node, fetch, replace(view, cards=kept), state, step)
+
+    monkeypatch.setattr(live.LiveCollector, "record_step", record_step)
+
+
+def line(e: dict[str, Any], run_id: str, listing: str = "03001") -> dict[str, Any]:
+    with e["factory"]() as s:
+        report = reconciliation.reconciliation(s, run_id)
+    return next(x for x in report["listings"] if x["listing_id"] == listing)
+
