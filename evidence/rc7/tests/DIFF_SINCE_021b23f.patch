+        s.add(
+            ListingPage(
+                run_id=run_id,
+                category_source_id=source.id,
+                csv_row_index=source.csv_row_index,
+                taxonomy_id=tax,
+                requested_filter={},
+                url=fetch.url,
+                route="listing",
