@@ -0,0 +1,504 @@
+"""Release 1.10.0rc7: a listing is complete only when the products its counted pages list are accounted for.
+
+Darren's review of the full run R7 (2026-11-20): the coverage file reported Dog Food 27017 and Cat Treats
+27022 DONE with no gap while 44 products of their counted pages had no record (OR-24); G3 read the cursor's
+own count (0.893 and 0.615, both below the 0.90 threshold, so R7 was refused). A smaller loss passes every
+threshold: one product of 61 is a coverage of 0.984, above the warning (0.98), and 1.10.0rc6 validated and
+published such a run.
+
+SYNTHETIC pages (``tests/listing_site.py``, the C1 site at Vernon Hills, Pickup) behind a local mock
+transport: no request leaves the process. A lost record is injected (``record_step`` leaves out the named
+cards: a counted page whose products are not kept, the class of OR-24). The publication target is each
+test's own throwaway database and folder. With ``PUBLICATION_EVIDENCE_DIR`` set, each test writes what it
+observed there.
+
+Tests named ``test_rc7_...`` fail on 1.10.0rc6 (``review-1.10.0rc6-20261117``); ``test_control_...`` pass on
+both. ``test_lanes_...`` compares two lanes with one on identical pages: in R7's order (a named product's page
+answered after the other lane's listing) it fails on 1.10.0rc6 (OR-24), in the other order it passes on both.
+The file loads on 1.10.0rc6 (it reads the coverage through what rc6 already has)."""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+import subprocess
+import sys
+from dataclasses import replace
+from datetime import timedelta
+from typing import Any
+
+import httpx
+import pytest
+from sqlalchemy import Engine, delete, select
+
+from marianos_headless import operations
+from marianos_headless.collection import live, reconciliation
+from marianos_headless.core.settings import PrivateLabelConfig, Settings
+from marianos_headless.db.models import (
+    Artifact,
+    ExportRow,
+    ListingPage,
+    MembershipRow,
+    NodeCoverage,
+    RecordRow,
+    Run,
+    ValidationFinding,
+)
+from marianos_headless.publishing.publish import PublicationRefused, latest_key, publish_run
+from tests import c1_site as c1
+from tests.c1_site import TARGET, C1Site, Clock
+from tests.integration import test_product_terms_collector as terms
+from tests.integration.test_publication_result import _complete_run, _context, _finish, env  # noqa: F401
+from tests.listing_site import products
+
+pytestmark = [pytest.mark.postgres]
+
+vh_env = terms.vh_env
+REASON = "synthetic test"
+
+
+# -- what the tests read -------------------------------------------------------------------------------------
+
+
+def incoherent_pages(s: Any, run_id: str) -> list[tuple[str, int, list[str]]]:
+    """An oracle of its own (not the collector's code): every completed page whose listed products are not
+    each kept by the run as a record placed under the page's listing."""
+    recs = set(s.scalars(select(RecordRow.upc).where(RecordRow.run_id == run_id)))
+    placed = {
+        (u, t)
+        for u, t in s.execute(
+            select(MembershipRow.upc, MembershipRow.taxonomy_id).where(
+                MembershipRow.run_id == run_id, MembershipRow.coupon_id.is_(None)
+            )
+        ).all()
+    }
+    out = []
+    for r in s.scalars(
+        select(ListingPage)
+        .where(ListingPage.run_id == run_id, ListingPage.state == "completed")
+        .order_by(ListingPage.taxonomy_id, ListingPage.requested_page)
+    ):
+        lost = [u for u in (r.identities or []) if u not in recs or (u, r.taxonomy_id) not in placed]
+        if lost:
+            out.append((r.taxonomy_id, r.requested_page, lost))
+    return out
+
+
+def published(e: dict[str, Any]) -> dict[str, Any] | None:
+    """The published dataset, byte for byte: the pointer, ``latest.json``, its manifest and products."""
+    from marianos_headless.db.models import PublicationPointer, Store
+
+    with e["factory"]() as s:
+        store = s.scalar(select(Store).where(Store.key == TARGET))
+        ptr = s.get(PublicationPointer, store.id) if store is not None else None
+        if ptr is None:
+            return None
+        state = {"publication_id": ptr.publication_id, "version": ptr.version}
+    latest = e["storage"].get_bytes(latest_key(TARGET))
+    body = json.loads(latest)
+    manifest = e["storage"].get_bytes(body["manifest_key"])
+    products_file = e["storage"].get_bytes(json.loads(manifest)["files"]["products.json"]["key"])
+    return {
+        **state,
+        "published_run": body["run_id"],
+        "latest_json_sha256": hashlib.sha256(latest).hexdigest(),
+        "manifest_sha256": hashlib.sha256(manifest).hexdigest(),
+        "products_sha256": hashlib.sha256(products_file).hexdigest(),
+    }
+
+
+def export_file(e: dict[str, Any], run_id: str, name: str) -> Any:
+    with e["factory"]() as s:
+        manifest = s.scalar(select(ExportRow).where(ExportRow.run_id == run_id, ExportRow.kind == "manifest"))
+        assert manifest is not None
+        art = s.get(Artifact, manifest.artifact_id)
+        assert art is not None
+        key = str(art.key)
+    files = json.loads(e["storage"].get_bytes(key))["files"]
+    return json.loads(e["storage"].get_bytes(files[name]["key"]))
+
+
+def evidence(name: str, data: dict[str, Any]) -> None:
+    out = os.environ.get("PUBLICATION_EVIDENCE_DIR")
+    if not out:
+        return
+    os.makedirs(out, exist_ok=True)
+    body = {"case": name, "evidence_type": c1.SYNTHETIC + "; the lost record is injected", **data}
+    with open(os.path.join(out, f"{name}.json"), "wb") as f:
+        f.write((json.dumps(body, indent=1, default=str, ensure_ascii=False) + "\n").encode("utf-8"))
+
+
+def drop_records(monkeypatch: pytest.MonkeyPatch, upcs: set[str]) -> None:
+    """The injected fault: the named cards of a page are never recorded while the page counts as read."""
+    original = live.LiveCollector.record_step
+
+    def record_step(self: Any, s: Any, node: Any, fetch: Any, view: Any, state: Any, step: int) -> Any:
+        kept = [c for c in view.cards if c.upc not in upcs]
+        return original(self, s, node, fetch, replace(view, cards=kept), state, step)
+
+    monkeypatch.setattr(live.LiveCollector, "record_step", record_step)
+
+
+def line(e: dict[str, Any], run_id: str, listing: str = "03001") -> dict[str, Any]:
+    with e["factory"]() as s:
+        report = reconciliation.reconciliation(s, run_id)
+    return next(x for x in report["listings"] if x["listing_id"] == listing)
+
+
+# -- a counted page with a product the run did not keep ------------------------------------------------------
+
+LOSSES = {
+    # 60 of 61: a coverage of 0.984, above both thresholds (1.10.0rc6 validated and published it)
+    "one_product_of_61": lambda ps: {ps[30].upc},
+    # page 2 whole (24 products, as Dog Food 27017 page 7 in R7): rc6 refused it (G3) and called it DONE
+    "page_2_whole": lambda ps: {p.upc for p in ps[24:48]},
+}
+
+
+@pytest.mark.parametrize("loss", sorted(LOSSES))
+def test_rc7_a_counted_product_without_a_record_is_incomplete_everywhere_and_never_published(
+    env: dict[str, Any],  # noqa: F811
+    settings: Settings,
+    monkeypatch: pytest.MonkeyPatch,
+    loss: str,
+) -> None:
+    ctx = _context(env)
+    first = _complete_run(env, settings)
+    assert _finish(env, ctx, first)["exit_code"] == 0
+    before = published(env)
+    assert before is not None and before["published_run"] == first
+    catalogue = products(61)
+    lost = LOSSES[loss](catalogue)
+    drop_records(monkeypatch, lost)
+    clock = Clock()
+    run_id, status = c1.run(env, settings, C1Site({"03001": catalogue}, clock), clock, max_reasks=None)
+    monkeypatch.undo()
+    whole = line(env, run_id)
+    with env["factory"]() as s:
+        cov = s.scalar(
+            select(NodeCoverage).where(NodeCoverage.run_id == run_id, NodeCoverage.taxonomy_id == "03001")
+        )
+        assert cov is not None
+        g3 = [
+            (f.severity, f.message)
+            for f in s.scalars(select(ValidationFinding).where(ValidationFinding.run_id == run_id))
+            if f.gate == "G3"
+        ]
+        holes = incoherent_pages(s, run_id)
+    out = _finish(env, ctx, run_id)
+    try:
+        operations.publish(ctx, run_id, REASON, "operator")
+        manual = "published"
+    except operations.CommandError as exc:
+        manual = f"refused (exit {int(exc.code)}): {exc}"
+    after = published(env)
+    exported = export_file(env, run_id, "coverage_reconciliation.json")
+    exported_line = next(x for x in exported["listings"] if x["listing_id"] == "03001")
+    evidence(
+        f"rc7_lost_record_{loss}",
+        {
+            "lost": sorted(lost),
+            "run_status": status,
+            "coverage_line": {k: whole.get(k) for k in ("status", "unique_identities", "unresolved_gap")}
+            | {k: whole.get(k) for k in ("accounted_identities", "missing_identities", "missing_by_page")},
+            "node_coverage": (cov.status, cov.organic_upcs, cov.total_count),
+            "g3": g3,
+            "incoherent_pages_oracle": holes,
+            "automatic": out,
+            "manual": manual,
+            "before": before,
+            "after": after,
+        },
+    )
+    assert holes == [("03001", 2, sorted(lost, key=[p.upc for p in catalogue].index))]  # the injected loss
+    # The coverage file, the node coverage, G3 and the export say the same.
+    assert (whole["status"], whole["unique_identities"], whole["unresolved_gap"]) == (
+        "INCOMPLETE",
+        61 - len(lost),
+        len(lost),
+    )
+    assert whole["missing_identities"] == len(lost) and set(whole["missing_by_page"]["2"]) == lost
+    assert (exported_line["status"], exported_line["missing_identities"]) == ("INCOMPLETE", len(lost))
+    assert (cov.status, cov.organic_upcs) == ("INCOMPLETE", 61 - len(lost))
+    assert ("FAIL", "status INCOMPLETE") in g3
+    assert status == "rejected"
+    # Neither publication path replaces the last good dataset, and both say so with a nonzero exit.
+    assert out["exit_code"] == 6 and out["run_status"] == "rejected"
+    assert manual.startswith("refused (exit 6)")
+    assert after == before
+
+
+def test_rc7_publication_reads_the_coverage_again_whatever_the_recorded_checks_say(
+    env: dict[str, Any],  # noqa: F811
+    settings: Settings,
+) -> None:
+    """A validated, complete run whose placement of one product under its listing is gone (removed in this
+    throwaway database after its checks): the recorded gates still pass, and neither the manual nor the
+    automatic publication replaces the last good dataset."""
+    ctx = _context(env)
+    first = _complete_run(env, settings)
+    assert _finish(env, ctx, first)["exit_code"] == 0
+    before = published(env)
+    second = _complete_run(env, settings, n=61)
+    gone = products(61)[30].upc
+    with env["factory"]() as s:
+        n = s.execute(
+            delete(MembershipRow).where(
+                MembershipRow.run_id == second,
+                MembershipRow.upc == gone,
+                MembershipRow.taxonomy_id == "03001",
+            )
+        ).rowcount
+        s.commit()
+        run = s.get(Run, second)
+        assert run is not None and run.status == "validated" and n == 1
+    with pytest.raises(PublicationRefused) as refused:
+        publish_run(env["factory"], env["storage"], second, "operator", warn_override_reason=REASON)
+    with pytest.raises(operations.CommandError) as cli:
+        operations.publish(ctx, second, REASON, "operator")
+    out = _finish(env, ctx, second)
+    after = published(env)
+    evidence(
+        "rc7_publication_rereads_coverage",
+        {"removed_placement": gone, "refusal": str(refused.value), "cli": str(cli.value), "automatic": out},
+    )
+    assert "coverage reconciliation failed" in str(refused.value) and gone in str(refused.value)
+    assert int(cli.value.code) == 6
+    assert out["exit_code"] == 6 and out["run_finished"]["publication"]["published"] is False
+    assert after == before
+
+
+def test_control_a_complete_run_reconciles_and_is_published(
+    env: dict[str, Any],  # noqa: F811
+    settings: Settings,
+) -> None:
+    ctx = _context(env)
+    run_id = _complete_run(env, settings, n=61)
+    whole = line(env, run_id)
+    assert (whole["status"], whole["unique_identities"], whole["unresolved_gap"]) == ("DONE", 61, 0)
+    with env["factory"]() as s:
+        assert incoherent_pages(s, run_id) == []
+    out = _finish(env, ctx, run_id)
+    assert out["exit_code"] == 0 and out["run_status"] == "published"
+
+
+# -- two lanes, both completion orders, against one lane -----------------------------------------------------
+
+
+class Gate:
+    """A fake Web API ``site`` holding one kind of request until another has been answered (or 10 s passed).
+
+    ``product_after_other``: a named product's own page waits for the other lane's listing (R7's order);
+    ``other_after_product``: the other lane's listing waits for the named product's page."""
+
+    def __init__(self, site: Any, other: str, order: str) -> None:
+        self.site, self.other, self.order = site, other, order
+        self.answered = {"product": asyncio.Event(), "other": asyncio.Event()}
+        self.waited: list[bool] = []
+
+    @property
+    def requests(self) -> list[dict[str, Any]]:
+        return list(self.site.requests)
+
+    def _is_other(self, body: dict[str, Any]) -> bool:
+        return self.other in body.get("url", "") or self.other == body.get("query")
+
+    async def __call__(self, request: httpx.Request) -> httpx.Response:
+        body = json.loads(request.content)
+        product = "/p/" in body.get("url", "")
+        wait_for = (
+            "other"
+            if product and self.order == "product_after_other"
+            else "product"
+            if self._is_other(body) and self.order == "other_after_product"
+            else None
+        )
+        if wait_for is not None:
+            try:
+                await asyncio.wait_for(self.answered[wait_for].wait(), 10)
+                self.waited.append(True)
+            except TimeoutError:
+                self.waited.append(False)
+        response = self.site(request)
+        if product:
+            self.answered["product"].set()
+        if self._is_other(body):
+            self.answered["other"].set()
+        return response
+
+
+class ProductPagesFail:
+    """``site``, with every product page answered as a provider failure (as ``test_lanes_or24``): the named
+    product's page is asked for once and its terms stay unread, for one lane and two alike."""
+
+    def __init__(self, site: Any) -> None:
+        self.site = site
+
+    @property
+    def requests(self) -> list[dict[str, Any]]:
+        return list(self.site.requests)
+
+    def __call__(self, request: httpx.Request) -> httpx.Response:
+        if "/p/" in json.loads(request.content).get("url", ""):
+            return httpx.Response(500, json={"detail": "REQUEST_FAILED_AFTER_TOO_MANY_RETRIES"})
+        return self.site(request)
+
+
+def fingerprint(e: dict[str, Any], run_id: str) -> dict[str, Any]:
+    """What a run kept, without its own identifiers: products, placements, page hashes, exclusions, export."""
+    with e["factory"]() as s:
+        recs = {
+            r.upc: (r.status, sorted(r.reasons or []), json.dumps(r.record, sort_keys=True, default=str))
+            for r in s.scalars(select(RecordRow).where(RecordRow.run_id == run_id))
+        }
+        members = sorted(
+            (m.upc, m.taxonomy_id, m.page_offset, m.position, m.via, m.placement)
+            for m in s.scalars(select(MembershipRow).where(MembershipRow.run_id == run_id))
+        )
+        pages = sorted(
+            (r.taxonomy_id, r.requested_page, r.state, r.response_sha256, tuple(r.identities or []))
+            for r in s.scalars(select(ListingPage).where(ListingPage.run_id == run_id))
+            if r.state == "completed"
+        )
+        holes = incoherent_pages(s, run_id)
+        report = reconciliation.reconciliation(s, run_id)
+    lines = {
+        x["listing_id"]: (x["status"], x["unique_identities"], x["unresolved_gap"])
+        for x in report["listings"]
+    }
+    exported = sorted(json.dumps(x, sort_keys=True) for x in export_file(e, run_id, "products.json"))
+    return {
+        "upcs": sorted(recs),
+        "records": recs,
+        "memberships": members,
+        "pages": pages,
+        "exclusions": {u: v[:2] for u, v in recs.items() if v[0] != "valid"},
+        "coverage": lines,
+        "export_sha256": hashlib.sha256("\n".join(exported).encode()).hexdigest(),
+        "incoherent_pages": holes,
+    }
+
+
+@pytest.mark.parametrize("order", ["product_after_other", "other_after_product"])
+def test_lanes_two_lanes_in_either_order_keep_what_one_lane_keeps(
+    migrated_engine: Engine, tmp_path: Any, private_label: PrivateLabelConfig, settings: Settings, order: str
+) -> None:
+    first, other = products(30, "0003800"), products(10, "0004400")
+    named = first[26].upc  # on the first listing's page 2: its own page is asked before the page's records
+    runs: dict[str, dict[str, Any]] = {}
+    e = c1.make_env(migrated_engine, tmp_path, private_label)
+    for lanes in (1, 2):  # the same store, one run after the other, on identical pages and clocks
+        clock = Clock()
+        site = ProductPagesFail(C1Site({"03001": first, "03002": other}, clock))
+        api: Any = Gate(site, "/03002", order) if lanes == 2 else site
+        run_id, status = c1.run(
+            e, settings, api, clock, listings=("03001", "03002"), lanes=lanes, product_term_upcs=[named]
+        )
+        runs[f"lanes_{lanes}"] = {
+            "run": run_id,
+            "status": status,
+            "waited": getattr(api, "waited", None),
+            **fingerprint(e, run_id),
+        }
+    one, two = runs["lanes_1"], runs["lanes_2"]
+    shown = ("status", "waited", "coverage", "export_sha256", "incoherent_pages", "upcs")
+    evidence(f"rc7_lanes_{order}", {k: {x: v[x] for x in shown} for k, v in runs.items()})
+    assert two["waited"] == [True]  # the lanes interleaved in the order named
+    assert one["incoherent_pages"] == two["incoherent_pages"] == []
+    for key in ("upcs", "records", "memberships", "pages", "exclusions", "coverage", "export_sha256"):
+        assert one[key] == two[key], key
+    assert one["coverage"]["03001"] == ("DONE", 30, 0) and one["coverage"]["03002"] == ("DONE", 10, 0)
+
+
+def test_control_on_the_search_route_the_other_lane_waiting_for_the_product_page_loses_nothing(
+    vh_env: dict[str, Any], settings: Settings
+) -> None:
+    """The order R7 did not see (the other lane's search waits for the named product's page); the order R7 saw
+    is ``test_lanes_or24``."""
+    from marianos_headless.collection.config import Limits
+
+    terms._ceiling(vh_env["factory"], 20)
+    api = Gate(terms.FakeTermsApi(), "Bars & Toaster Pastries", "other_after_product")
+    run_id = terms._run(
+        vh_env,
+        settings,
+        api,  # type: ignore[arg-type]
+        read=False,
+        limits=Limits(max_concurrent_listings=2, product_term_upcs=[terms.PURINA.upc]),
+    )
+    assert api.waited == [True]
+    with vh_env["factory"]() as s:
+        recorded = {r.upc for r in s.scalars(select(RecordRow).where(RecordRow.run_id == run_id))}
+        cereal = {terms.PURINA.upc, terms.LAMB.upc, terms.ENERGIZER.upc, terms.TEMPTATIONS.upc}
+        assert cereal | {terms.PLAIN.upc} <= recorded, sorted(cereal - recorded)
+        pages = sorted(
+            (r.taxonomy_id, r.state, r.new_count)
+            for r in s.scalars(select(ListingPage).where(ListingPage.run_id == run_id))
+        )
+        assert pages == [("03001", "completed", 4), ("03002", "completed", 1)]
+        assert incoherent_pages(s, run_id) == []
+
+
+# -- a worker killed between two lanes' pages, then resumed --------------------------------------------------
+
+
+def test_control_a_two_lane_worker_killed_mid_run_leaves_every_counted_page_whole_and_resume_completes_it(
+    migrated_engine: Engine, tmp_path: Any, private_label: PrivateLabelConfig, settings: Settings
+) -> None:
+    listings = {"03001": [60], "03002": [30, "0003805"]}
+    e = c1.make_env(migrated_engine, tmp_path, private_label)
+    clock = Clock()
+    pipe = c1.pipe_of(e, settings)
+    run_id = c1.plan(e, pipe, c1.nodes_of(e, tuple(listings)))
+    args = {
+        "db": migrated_engine.url.render_as_string(hide_password=False),
+        "data": str(tmp_path / "data"),
+        "run": run_id,
+        "now": clock.now().isoformat(),
+        "listings": listings,
+        "listing": "03002",
+        "page": 2,
+        "nth": 1,
+        "lanes": 2,
+        "max_reasks": None,
+    }
+    p = subprocess.run(
+        [sys.executable, "-m", "tests.c1_site", json.dumps(args)],
+        cwd=c1.ROOT,
+        env=dict(os.environ),
+        capture_output=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=300,
+        check=False,
+    )
+    assert p.returncode == 137, (p.returncode, p.stdout[-1500:], p.stderr[-1500:])
+    with e["factory"]() as s:
+        killed = incoherent_pages(s, run_id)
+        counted = sorted(
+            (r.taxonomy_id, r.requested_page)
+            for r in s.scalars(
+                select(ListingPage).where(ListingPage.run_id == run_id, ListingPage.state == "completed")
+            )
+        )
+    clock.t += timedelta(seconds=1)
+    site = C1Site({k: products(*v) for k, v in listings.items()}, clock)
+    _, status = c1.run(e, settings, site, clock, run_id=run_id, lanes=2, max_reasks=None)
+    resumed = fingerprint(e, run_id)
+    evidence(
+        "rc7_two_lane_kill_then_resume",
+        {
+            "counted_at_kill": counted,
+            "incoherent_at_kill": killed,
+            "status": status,
+            "coverage": resumed["coverage"],
+        },
+    )
+    assert killed == []  # every page counted when the worker died has its products, all of them
+    assert ("03002", 2) not in counted and ("03001", 1) in counted
+    assert all(site.times(k, n) == 0 for k, n in counted)  # a counted page is never asked for again
+    assert resumed["incoherent_pages"] == []
+    assert resumed["coverage"]["03001"] == ("DONE", 60, 0) and resumed["coverage"]["03002"] == ("DONE", 30, 0)
+    assert len(resumed["upcs"]) == 90
